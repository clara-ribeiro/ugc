# Canonical production URL used by metadata, sitemap, robots, and JSON-LD.
# Example: https://ugc.clamari.com.br
SITE_URL=

# Contact form. Deploy scripts/google-contact-webhook.js as an Apps Script
# web app (Execute as: Me, Who has access: Anyone), then paste the URL.
GOOGLE_SHEETS_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
CONTACT_TO_EMAIL=clararibeiro.ugc@gmail.com

# Optional. If set, the API sends mail via Resend and the sheet webhook
# only appends the row. Otherwise the Apps Script emails you from Gmail.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
